    "8",
    "--kvtc_sink_tokens",
    "4",
    "--kvtc_window_tokens",
    "128",
    "--kvtc_root_k",
    "${KVTC_ARTIFACTS}/k",
    "--kvtc_root_v",
    "${KVTC_ARTIFACTS}/v"
  ]
}
