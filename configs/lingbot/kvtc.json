{
  "env": {
    "OMP_NUM_THREADS": "56",
    "MKL_NUM_THREADS": "56"
  },
  "args": [
    "--task",
    "i2v-A14B",
    "--infer_mode",
    "causal_fast",
    "--size",
    "480*832",
    "--frame_num",
    "125",
    "--chunk_size",
    "4",
    "--base_seed",
