{
  "format": "mg35_kvcodec_two_block_retrace_experiment_v1",
  "model": "Matrix-Game-3.5-Distilled first-person",
  "inference_config": "configs/infer_distilled_2blocks_retrace.yaml",
  "trajectory_manifest": "data/mg35_two_block_retrace_v1/manifest.json",
  "seed": 3407,
  "blocks": 2,
  "camera_poses_per_block": 84,
  "split_protocol": {
    "train": "case_0..3 x [left_right, forward_backward] = 8 trajectories",
    "dev": "case_4..5 x [left_right, forward_backward] = 4 trajectories",
    "heldout": "case_6..7 x 4 actions = 8 videos",
    "scene_and_image_disjoint": true
  },
  "calibration": {
    "rows_per_selected_cache_write": 1024,
    "selected_cache_writes_per_trajectory": 4,
    "maximum_rows_per_trajectory_layer_target": 4096,
    "selection": "deterministic_evenly_spaced",
    "targets": ["k", "v", "k_c64", "v_c64"],
    "train_rows_per_layer_target": 32768,
    "dev_rows_per_layer_target": 16384,
    "write_id_rule": "freeze four lifecycle-probed writes spanning both blocks before collection"
  },
  "method": {
    "semantic_clusters": 64,
    "semantic_iterations": 2,
    "pca_rank": 768,
    "latent_bits": 4,
    "center_storage_candidates": ["bf16", "int8_block64"],
    "k_post_training": "strict HY K-A1, six causal groups x five MG layers",
    "v_post_training": "strict HY V C64 INT4-QAT"
  },
  "evaluation_ladder": [
    "clean",
    "pca768_int4",
    "c64_pca768_int4",
    "c64_pca768_int4_v_qat",
    "c64_pca768_int4_v_qat_k_a1"
  ],
  "baseline": {
    "name": "KVTC",
    "same_training_rows_and_sample_ids": true,
    "formal_online_use_blocked_until_streaming_lifecycle_parity": true
  }
}
